//2024/12/11 
v1.0
#include "HomeSpan.h"
// #include "DEV_LED.h"

// 定义相关参数
#define key 0       // boot按键引脚
#define led 2       // 板载led引脚
#define PWM_CHANNEL 0        // PWM通道
#define PWM_FREQ 38090       // PWM频率（38.09 kHz）
#define PWM_RESOLUTION 8     // PWM分辨率（8位，0~255）
#define PWM_DUTY 128         // 占空比50%对应128 (8位最大值是255)
#define PWM_PIN 15           // 使用GPIO15

// R05D协议的数据 关机
#define Data_A 0xB2 // 1011 0010
#define OFF_B 0x7B  // 0111 1011
#define OFF_C 0xE0  // 1110 0000

// 延迟微秒函数（ESP32自带delayMicroseconds）
void delay_us(uint32_t us) {
    delayMicroseconds(us);
}

// 引导码
void Lead_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY); // 设置占空比为50%
    delay_us(4400);                  // 低电平持续4400us
    ledcWrite(PWM_CHANNEL, 0);       // 停止PWM
    delay_us(4400);                  // 高电平持续4400us
}

// 停止码
void Stop_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(5220);                  // 高电平持续5220us
}

// 发送0码
void Send_0_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(540);                   // 高电平持续540us
}

// 发送1码
void Send_1_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(1620);                  // 高电平持续1620us
}

// 发送一个字节
void Send_Byte(uint8_t data) {
    for (int i = 7; i >= 0; i--) {
        if (data & (1 << i)) {
            Send_1_Code();
        } else {
            Send_0_Code();
        }
    }
}

void Normal_Code(uint8_t A, uint8_t B, uint8_t C) {
    Lead_Code();               // 引导码
    Send_Byte(A);              // 地址字节
    Send_Byte(~A);             // 地址反码
    Send_Byte(B);              // 数据字节
    Send_Byte(~B);             // 数据反码
    Send_Byte(C);              // 校验字节
    Send_Byte(~C);             // 校验反码
    Stop_Code();               // 停止码

    // 再次发送相同的信号
    Lead_Code();
    Send_Byte(A);
    Send_Byte(~A);
    Send_Byte(B);
    Send_Byte(~B);
    Send_Byte(C);
    Send_Byte(~C);
    Stop_Code();
}

// 定义温度风速和模式的映射
#define T_17 0x00
#define T_18 0x10
#define T_19 0x30
#define T_20 0x20
#define T_21 0x60
#define T_22 0x70
#define T_23 0x50
#define T_24 0x40
#define T_25 0xC0
#define T_26 0xD0
#define T_27 0x90
#define T_28 0x80
#define T_29 0xA0
#define T_30 0xB0

#define AUTO 0x08
#define COOL 0x00
#define WET  0x04
#define HOT  0x0C
#define WIND 0xE4

#define AUTO_SPEED 0xA0
#define LOW_SPEED  0x80
#define MEDIUM_SPEED 0x40
#define HIGH_SPEED 0x20
#define FIXED_SPPED 0x00

// 温度表、模式表和风速表
uint8_t Table_TEMP[14] = {T_17, T_18, T_19, T_20, T_21, T_22, T_23, T_24, T_25, T_26, T_27, T_28, T_29, T_30};
uint8_t Table_Speed[5] = {LOW_SPEED, MEDIUM_SPEED, HIGH_SPEED, AUTO_SPEED, FIXED_SPPED};
uint8_t Table_Mode[5] = {AUTO, HOT, COOL, WET, WIND};

// 设置温度、风速和模式
void NEC_SET_DATA(uint8_t temperature, uint8_t speed, uint8_t mode) {
    uint8_t Data_B = 0x1F, Data_C = 0x00;
    Data_B |= Table_Speed[speed];  // 设置风速

    if (Table_Mode[mode] == WIND) {
        Data_C |= Table_Mode[mode];  // 送风模式
    } else {
        Data_C |= (Table_TEMP[temperature - 17] + Table_Mode[mode]);  // 设置温度和模式
    }

    Normal_Code(Data_A, Data_B, Data_C);  // 发送数据
}

// 关空调
void AC_OFF() {
     Normal_Code(0xB2, 0x7B, 0xE0);
}

// 空调控制函数
void AC_ON() {
    NEC_SET_DATA(28, 1, 1);  // 发送开机命令
}

// 空调控制类，继承自 Service::LightBulb
struct DEV_AC : Service::LightBulb {
    int acPin;  // 空调控制引脚
    SpanCharacteristic *power;  // 电源控制

    DEV_AC(int pin) : Service::LightBulb() {
        acPin = pin;
        power = new Characteristic::On();  // 开关控制
        pinMode(acPin, OUTPUT);  // 设置为输出模式
    }

    boolean update() {
        // 根据开关状态控制空调
        if (power->getNewVal()) {
            AC_ON();  // 开启空调
        } else {
            AC_OFF();  // 关闭空调
        }
        return true;  // 返回成功
    }
};

void setup() {
    Serial.begin(115200);
    homeSpan.begin(Category::Lighting, "HomeSpan AC");

    new SpanAccessory();  // 第一个配件（空调）
    new Service::AccessoryInformation();
    new Characteristic::Identify();
    new DEV_AC(15);  // 使用pin 15 控制空调

    // 配置按键引脚为上拉输入模式，用于boot按键检测
    pinMode(key, INPUT_PULLUP);
    pinMode(led, OUTPUT);  // 设置板载LED为输出模式
    digitalWrite(led, LOW);  // 熄灭LED指示灯

    // 初始化PWM输出
    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
    ledcAttachPin(PWM_PIN, PWM_CHANNEL);
    ledcWrite(PWM_CHANNEL, 0);  // 初始化占空比为0（停止PWM信号）
}

void loop() {
    homeSpan.poll();  // 处理 HomeKit 请求
    if (digitalRead(key) == 0) {  // 按键被按下
        // 如果按键被按下，开关空调
        static bool acState = false;
        acState = !acState;
        if (acState) {
            AC_ON();
            digitalWrite(led, HIGH);  // 点亮LED指示灯
        } else {
            AC_OFF();
            digitalWrite(led, LOW);  // 熄灭LED指示灯
        }
    } 
}

