#include "HomeSpan.h"

// 定义相关参数
#define key 0       // boot按键引脚
#define led 2       // 板载led引脚
#define PWM_CHANNEL 0        // PWM通道
#define PWM_FREQ 38090       // PWM频率（38.09 kHz）
#define PWM_RESOLUTION 8     // PWM分辨率（8位，0~255）
#define PWM_DUTY 128         // 占空比50%对应128 (8位最大值是255)
#define PWM_PIN 15           // 使用GPIO15

// R05D协议的数据 关机
#define Data_A 0xB2 // 1011 0010
#define OFF_B 0x7B  // 0111 1011
#define OFF_C 0xE0  // 1110 0000

// 延迟微秒函数（ESP32自带delayMicroseconds）
void delay_us(uint32_t us) {
    delayMicroseconds(us);
}

// 引导码
void Lead_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY); // 设置占空比为50%
    delay_us(4400);                  // 低电平持续4400us
    ledcWrite(PWM_CHANNEL, 0);       // 停止PWM
    delay_us(4400);                  // 高电平持续4400us
}

// 停止码
void Stop_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(5220);                  // 高电平持续5220us
}

// 发送0码
void Send_0_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(540);                   // 高电平持续540us
}

// 发送1码
void Send_1_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);                   // 低电平持续540us
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(1620);                  // 高电平持续1620us
}

// 发送一个字节
void Send_Byte(uint8_t data) {
    for (int i = 7; i >= 0; i--) {
        if (data & (1 << i)) {
            Send_1_Code();
        } else {
            Send_0_Code();
        }
    }
}

void Normal_Code(uint8_t A, uint8_t B, uint8_t C) {
    Lead_Code();               // 引导码
    Send_Byte(A);              // 地址字节
    Send_Byte(~A);             // 地址反码
    Send_Byte(B);              // 数据字节
    Send_Byte(~B);             // 数据反码
    Send_Byte(C);              // 校验字节
    Send_Byte(~C);             // 校验反码
    Stop_Code();               // 停止码

    // 再次发送相同的信号
    Lead_Code();
    Send_Byte(A);
    Send_Byte(~A);
    Send_Byte(B);
    Send_Byte(~B);
    Send_Byte(C);
    Send_Byte(~C);
    Stop_Code();
}

// 定义温度风速和模式的映射
typedef enum
{
    T_17 = 0x00
    T_18 = 0x10
    T_19 = 0x30
    T_20 = 0x20
    T_21 = 0x60
    T_22 = 0x70
    T_23 = 0x50
    T_24 = 0x40
    T_25 = 0xC0
    T_26 = 0xD0
    T_27 = 0x90
    T_28 = 0x80
    T_29 = 0xA0
    T_30 = 0xB0
}T;

typedef enum
{
    AUTO = 0x08
    COOL = 0x00
    WET  = 0x04
    HOT  = 0x0C
    WIND = 0xE4
}M;

typedef enum{

  AUTO_SPEED = 0xA0
  LOW_SPEED  = 0x80
  MEDIUM_SPEED = 0x40
  HIGH_SPEED = 0x20
  FIXED_SPPED = 0x00
}S;
uint8_t Table_TEMP[14] = {T_17, T_18, T_19, T_20, T_21, T_22, T_23, T_24, T_25, T_26, T_27, T_28, T_29, T_30};
uint8_t Table_Speed[5] = {LOW_SPEED, MEDIUM_SPEED, HIGH_SPEED, AUTO_SPEED, FIXED_SPPED};
uint8_t Table_Mode[4] = {COOL, HOT, WET, WIND};

// 设置温度、风速和模式
void NEC_SET_DATA(uint8_t temperature, uint8_t speed, uint8_t mode) {
    if (temperature < 17 || temperature > 30) {
        Serial.println("Invalid temperature. Skipping IR transmission.");
        return;
    }

    uint8_t Data_B = 0x1F, Data_C = 0x00;
    Data_B |= Table_Speed[speed];  // 设置风速

    if (Table_Mode[mode] == 0xE4) {
        Data_C |= Table_Mode[mode];  // 送风模式
    } else {
        Data_C |= (Table_TEMP[temperature - 17] + Table_Mode[mode]);  // 设置温度和模式
    }

    Normal_Code(Data_A, Data_B, Data_C);  // 发送数据
    Serial.print("IR Code Sent: A=");
    Serial.print(Data_A, HEX);
    Serial.print(", B=");
    Serial.print(Data_B, HEX);
    Serial.print(", C=");
    Serial.println(Data_C, HEX);
}

// 关空调
void AC_OFF() {
    Normal_Code(Data_A, OFF_B, OFF_C);
    Serial.println("IRCODE: OFF");
}

struct DEV_AC : Service::Thermostat {
    int acPin;
    SpanCharacteristic *currentTemp;
    SpanCharacteristic *targetTemp;
    SpanCharacteristic *mode;
    SpanCharacteristic *power;
    SpanCharacteristic *fanSpeed;
    SpanCharacteristic *currentHeatingCoolingState;
    SpanCharacteristic *temperatureDisplayUnits;



    DEV_AC(int pin) : Service::Thermostat() {
        acPin = pin;

        currentTemp = new Characteristic::CurrentTemperature(24.0);  // 当前温度
        targetTemp = new Characteristic::TargetTemperature(24.0);    // 目标温度
        targetTemp->setRange(17.0, 30.0, 1.0);                        // 目标温度范围
        mode = new Characteristic::TargetHeatingCoolingState(1);      // 模式（加热、制冷等）
        power = new Characteristic::On();                              // 电源（开启或关闭）
        fanSpeed = new Characteristic::RotationSpeed(0);              // 风速（默认值）
        currentHeatingCoolingState = new Characteristic::CurrentHeatingCoolingState(0);
        temperatureDisplayUnits = new Characteristic::TemperatureDisplayUnits(0);

        pinMode(acPin, OUTPUT);  // 设置空调引脚为输出
    }

    boolean update() {
        // 获取HomeKit中的目标温度、模式和风速
        float temp = targetTemp->getNewVal();
        int state = mode->getNewVal();  // 获取模式（加热、制冷等）
        int speed = fanSpeed->getNewVal();  // 获取风速

        // 根据mode（状态）选择对应的IR信号模式
        int irMode = 0;
        switch (state) {
            case 0:  // 关闭空调
                AC_OFF();
                break;
            case 1:  // 加热模式
                irMode = HOT;
                break;
            case 2:  // 制冷模式
                irMode = COOL;
                break;
            case 3:  // 自动模式
                irMode = AUTO;
                break;
            default:
                Serial.println("Invalid Mode Selected. No signal sent.");
                return false;  // 如果模式无效，直接返回
        }

        // 调用 NEC_SET_DATA 发送红外信号
        NEC_SET_DATA((uint8_t)temp, speed, irMode);  
        return true;
    }
};

void setup() {
   
  WiFiClient client;
  WiFi.disconnect();
    Serial.begin(115200);
    

    homeSpan.setWifiCredentials("I love you.", "34222220");

    homeSpan.begin(Category::AirConditioners, "空调");

    new SpanAccessory();
    new Service::AccessoryInformation();
    new Characteristic::Identify();
    new DEV_AC(15);

    pinMode(key, INPUT_PULLUP);
    pinMode(led, OUTPUT);
    digitalWrite(led, LOW);

    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
    ledcAttachPin(PWM_PIN, PWM_CHANNEL);
    ledcWrite(PWM_CHANNEL, 0);
}

void loop() {
    homeSpan.poll();
    if (digitalRead(key) == 0) {
        static bool acState = false;
        acState = !acState;
        if (acState) {
            NEC_SET_DATA(28, 1, 1);
            digitalWrite(led, HIGH);
            delay(500);
            digitalWrite(led, LOW);
        } else {
            AC_OFF();
            digitalWrite(led, LOW);
        }
    }
}




v1.2
#include "HomeSpan.h"

// 定义相关参数
#define key 0       // boot按键引脚
#define led 2       // 板载led引脚
#define PWM_CHANNEL 0        // PWM通道
#define PWM_FREQ 38090       // PWM频率（38.09 kHz）
#define PWM_RESOLUTION 8     // PWM分辨率（8位，0~255）
#define PWM_DUTY 128         // 占空比50%对应128 (8位最大值是255)
#define PWM_PIN 15           // 使用GPIO15

// R05D协议的数据 关机
#define Data_A 0xB2 // 1011 0010
#define OFF_B 0x7B  // 0111 1011
#define OFF_C 0xE0  // 1110 0000

// 温度表和模式表
uint8_t Table_Speed[5] = {0x80, 0x40, 0x20, 0xA0, 0x00}; // 低速、中速、高速、自动、固定
uint8_t Table_Mode[5] = {0x00, 0x11, 0x01, 0x01, 0x10};  // 制冷、加热、除湿、送风、自动

// 延迟微秒函数
void delay_us(uint32_t us) {
    delayMicroseconds(us);
}

// 引导码
void Lead_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY); // 设置占空比为50%
    delay_us(4400);
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(4400);
}

// 停止码
void Stop_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(5220);
}

// 发送0码
void Send_0_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(540);
}

// 发送1码
void Send_1_Code() {
    ledcWrite(PWM_CHANNEL, PWM_DUTY);
    delay_us(540);
    ledcWrite(PWM_CHANNEL, 0);
    delay_us(1620);
}

// 发送一个字节
void Send_Byte(uint8_t data) {
    for (int i = 7; i >= 0; i--) {
        if (data & (1 << i)) {
            Send_1_Code();
        } else {
            Send_0_Code();
        }
    }
}

// 发送普通码
void Normal_Code(uint8_t A, uint8_t B, uint8_t C) {
    Lead_Code();
    Send_Byte(A);
    Send_Byte(~A);
    Send_Byte(B);
    Send_Byte(~B);
    Send_Byte(C);
    Send_Byte(~C);
    Stop_Code();

    Lead_Code();
    Send_Byte(A);
    Send_Byte(~A);
    Send_Byte(B);
    Send_Byte(~B);
    Send_Byte(C);
    Send_Byte(~C);
    Stop_Code();
}

// Forward declaration of functions
uint8_t mapTempToIR(int temp);
uint8_t mapModeToIR(int state);

// 温度到IR码的映射
uint8_t mapTempToIR(int temp) {
    uint8_t irTemp;
    switch (temp) {
        case 17: irTemp = 0x00; break; 
        case 18: irTemp = 0x01; break; 
        case 19: irTemp = 0x03; break; 
        case 20: irTemp = 0x02; break; 
        case 21: irTemp = 0x06; break; 
        case 22: irTemp = 0x07; break; 
        case 23: irTemp = 0x05; break; 
        case 24: irTemp = 0x04; break; 
        case 25: irTemp = 0x0C; break; 
        case 26: irTemp = 0x0D; break; 
        case 27: irTemp = 0x09; break; 
        case 28: irTemp = 0x08; break; 
        case 29: irTemp = 0x0A; break; 
        case 30: irTemp = 0xB0; break; 
        default: irTemp = 0x00; break; 
    }
    return irTemp;
}

// 模式到IR码的映射
uint8_t mapModeToIR(int state) {
    uint8_t irMode;
    switch (state) {
        case 1: irMode = 0x11; break;  // 加热
        case 0: irMode = 0x00; break;  // 制冷
        case 3: irMode = 0x10; break;  // 自动
        default: irMode = 0x00; break; // 默认模式
    }
    return irMode;
}

void NEC_SET_DATA(uint8_t temperature, uint8_t speed, uint8_t mode) {
    // 检查温度是否有效（17°C到30°C之间）
    if (temperature < 17 || temperature > 30) {
        Serial.println("Invalid temperature. Skipping IR transmission.");
        return;
    }

    // 1. 构造 B 和 C 的二进制数据
    uint8_t Data_B = 0x1F;  // B的初始值
    uint8_t Data_C = 0x00;  // C的初始值

    // 根据风速映射，设置 B
    Data_B |= Table_Speed[0];
    
    // 根据模式选择温度编码
    uint8_t irTemp = mapTempToIR(temperature);
    uint8_t irMode = mapModeToIR(mode);
    Data_C |= (irTemp + irMode); 

    // 2. 发送数据帧（A, B, C）
    Normal_Code(Data_A, Data_B, Data_C);  // 使用 Normal_Code 发送
    Normal_Code(Data_A, Data_B, Data_C);  // 使用 Normal_Code 发送
    // 打印发送的数据（调试用）
    Serial.print("IR Code Sent: A=");
    Serial.print(Data_A, HEX);
    Serial.print(" , B=");
    Serial.print(Data_B, HEX);
    Serial.print(" , C=");
    Serial.println(Data_C, HEX);
}


// 空调关机
void AC_OFF() {
    Normal_Code(Data_A, OFF_B, OFF_C);
    Serial.println("IRCODE: OFF");
}

// HomeKit设备类
struct DEV_AC : Service::Thermostat {
    int acPin;
    SpanCharacteristic *currentTemp;
    SpanCharacteristic *targetTemp;
    SpanCharacteristic *mode;
    SpanCharacteristic *power;
    SpanCharacteristic *displayUnits;

    DEV_AC(int pin) : Service::Thermostat() {
        acPin = pin;

        currentTemp = new Characteristic::CurrentTemperature(24.0);
        targetTemp = new Characteristic::TargetTemperature(24.0);
        targetTemp->setRange(17.0, 30.0, 1.0);
        mode = new Characteristic::TargetHeatingCoolingState(0);
        power = new Characteristic::On();
        displayUnits = new Characteristic::TemperatureDisplayUnits(0);

        pinMode(acPin, OUTPUT);
    }

    boolean update() {
        float temp = targetTemp->getNewVal();
        int state = mode->getNewVal();
        
        Serial.print("APP_TEMP ");
        Serial.print(temp);
        Serial.print(", APP_MODE ");
        Serial.println(state);

        if (state == 0) {
            AC_OFF();
        } else {
            NEC_SET_DATA(targetTemp->getNewVal(), 0x80, mode->getNewVal());

            Serial.print("APP回传的温度 ");
            Serial.print(temp);
             Serial.print(",APP回传的模式 ");
            Serial.print(state);
        }

        return true;
    }
};

// 初始化
void setup() {
    Serial.begin(115200);
    homeSpan.setWifiCredentials("I love you.", "34222220");
    homeSpan.begin(Category::AirConditioners, "空调");

    new SpanAccessory();
    new Service::AccessoryInformation();
    new Characteristic::Identify();
    new DEV_AC(15);

    pinMode(key, INPUT_PULLUP);
    pinMode(led, OUTPUT);
    digitalWrite(led, LOW);

    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
    ledcAttachPin(PWM_PIN, PWM_CHANNEL);
    ledcWrite(PWM_CHANNEL, 0);
}

// 主循环
void loop() {
    homeSpan.poll();
    if (digitalRead(key) == 0) {
        static bool acState = false;
        acState = !acState;
        if (acState) {
            NEC_SET_DATA(28, 1, 1);
            digitalWrite(led, HIGH);
            delay(500);
            digitalWrite(led, LOW);
        } else {
            AC_OFF();
            digitalWrite(led, LOW);
        }
    }
}
