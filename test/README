
This directory is intended for PlatformIO Unit Testing and project tests.

Unit Testing is a software testing method by which individual units of
source code, sets of one or more MCU program modules together with associated
control data, usage procedures, and operating procedures, are tested to
determine whether they are fit for use. Unit testing finds problems early
in the development cycle.

More information about PlatformIO Unit Testing:
- https://docs.platformio.org/page/plus/unit-testing.html
#include <Arduino.h>

// 定义GPIO引脚
#define PWM_PIN 15  // 可根据实际连接调整

// R05D协议的数据
#define OFF_B 0x7B  // 0111 1011
#define OFF_C 0xE0  // 1110 0000
#define Data_A 0xB2 // 1011 0010

// 发送逻辑1和逻辑0
void Write_Code_1() {
  ledcWrite(0, 1023);  // 高电平，PWM占空比100%
  delayMicroseconds(540);  // 保持540us
  ledcWrite(0, 0);  // 低电平
  delayMicroseconds(1620);  // 保持1620us
}

void Write_Code_0() {
  ledcWrite(0, 1023);  // 高电平
  delayMicroseconds(540);  // 保持540us
  ledcWrite(0, 0);  // 低电平
  delayMicroseconds(540);  // 保持540us
}

void Write_Code_L() {
  ledcWrite(0, 1023);  // 高电平
  delayMicroseconds(4400);  // 保持4400us
  ledcWrite(0, 0);  // 低电平
  delayMicroseconds(4400);  // 保持4400us
}

void Write_Code_S() {
  ledcWrite(0, 1023);  // 高电平
  delayMicroseconds(540);  // 保持540us
  ledcWrite(0, 0);  // 低电平
  delayMicroseconds(5220);  // 保持5220us
}

// 发送字节
void Send_Byte(uint8_t Data) {
  for (int i = 7; i >= 0; i--) {
    if (Data & (1 << i)) {
      Write_Code_1();  // 发送逻辑1
    } else {
      Write_Code_0();  // 发送逻辑0
    }
  }
}

// 发送 R05D 协议的数据
void SEND_R05D(uint8_t A, uint8_t B, uint8_t C) {
  Write_Code_L();  // 发送引导码L

  Send_Byte(A);
  Send_Byte(~A);   // 发送A的反码
  Send_Byte(B);
  Send_Byte(~B);   // 发送B的反码
  Send_Byte(C);
  Send_Byte(~C);   // 发送C的反码

  Write_Code_S();  // 发送分隔码S
}

// 发送关闭命令
void R05D_CLOSE() {
  SEND_R05D(Data_A, OFF_B, OFF_C);  // 发送关闭命令
}

// 定义温度、风速和模式的映射
#define T_17 0x00
#define T_18 0x10
#define T_19 0x30
#define T_20 0x20
#define T_21 0x60
#define T_22 0x70
#define T_23 0x50
#define T_24 0x40
#define T_25 0xC0
#define T_26 0xD0
#define T_27 0x90
#define T_28 0x80
#define T_29 0xA0
#define T_30 0xB0

#define AUTO 0x08
#define COOL 0x00
#define WET  0x04
#define HOT  0x0C
#define WIND 0xE4

#define AUTO_SPEED 0xA0
#define LOW_SPEED  0x80
#define MEDIUM_SPEED 0x40
#define HIGH_SPEED 0x20
#define FIXED_SPPED 0x00

// 温度表、模式表和风速表
uint8_t Table_TEMP[14] = {T_17, T_18, T_19, T_20, T_21, T_22, T_23, T_24, T_25, T_26, T_27, T_28, T_29, T_30};
uint8_t Table_Mode[5] = {AUTO, HOT, COOL, WET, WIND};
uint8_t Table_Speed[5] = {LOW_SPEED, MEDIUM_SPEED, HIGH_SPEED, AUTO_SPEED, FIXED_SPPED};

// 设置温度、风速和模式
void NEC_SET_DATA(uint8_t temperature, uint8_t speed, uint8_t mode) {
  uint8_t Data_B = 0x1F, Data_C = 0x00;

  Data_B |= Table_Speed[speed];  // 设置风速

  if (Table_Mode[mode] == WIND) {
    Data_C |= Table_Mode[mode];  // 送风模式
  } else {
    Data_C |= (Table_TEMP[temperature - 17] + Table_Mode[mode]);  // 设置温度和模式
  }

  SEND_R05D(Data_A, Data_B, Data_C);  // 发送数据

}

void setup() {
  Serial.begin(115200);  // 初始化串口，波特率115200

  // 设置 PWM 引脚模式
  ledcSetup(0, 1000, 8);  // 设置频道0，频率1kHz，占空比8位
  ledcAttachPin(PWM_PIN, 0);  // 绑定PWM信号到指定的GPIO引脚

  // 调用 NEC_SET_DATA，设置温度、风速和模式
  NEC_SET_DATA(22, 2, 2);  // 设置温度22°C，风速高，制冷模式
  delay(2000);
  R05D_CLOSE();  // 发送关闭命令
}

void loop() {
  // 循环控制
  NEC_SET_DATA(17, 0, 0);  // 设置温度17°C，风速低，自动模式
  delay(5000);  // 延时5秒
  NEC_SET_DATA(26, 1, 1);  // 设置温度26°C，风速中，制热模式
  delay(5000);  // 延时5秒
}



