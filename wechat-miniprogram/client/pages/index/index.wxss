page {
  background: #f5f7f8;
  color: #172026;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 188rpx;
  background: #f5f7f8;
}

.status-plate {
  padding: 28rpx;
  border: 1rpx solid #dce4e8;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 38, 0.06);
}

.header,
.device-row,
.card-row,
.env-bar,
.bottom-dock,
.dial-controls,
.segment-control,
.sheet-item {
  display: flex;
  align-items: center;
}

.header,
.device-row,
.card-row {
  justify-content: space-between;
}

.header-left,
.device-copy,
.card-texts,
.sheet-texts,
.env-item {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  font-size: 20rpx;
  line-height: 1;
  color: #6f7f89;
}

.title {
  margin-top: 10rpx;
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #172026;
}

.ble-pill {
  min-width: 148rpx;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.ble-pill.connected {
  color: #0f6b3a;
  background: #e8f7ee;
  border: 1rpx solid #b9e3c9;
}

.ble-pill.disconnected {
  color: #8a4b00;
  background: #fff5e4;
  border: 1rpx solid #f3d6a8;
}

.device-row {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1f3;
}

.device-label,
.card-title,
.env-lbl,
.sheet-sub {
  font-size: 23rpx;
  color: #7b8a93;
}

.device-name {
  max-width: 470rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #2a363d;
  font-weight: 600;
}

.device-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  color: #1f6feb;
  background: #f0f6ff;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 32rpx;
  padding: 56rpx 34rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dce4e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-device {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f6feb;
  background: #eef5ff;
  font-size: 46rpx;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #172026;
}

.empty-desc {
  margin-top: 16rpx;
  max-width: 520rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6f7f89;
}

.primary-btn {
  margin-top: 36rpx;
  width: 100%;
  height: 92rpx;
  border: 0;
  border-radius: 14rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.primary-btn::after {
  border: 0;
}

.primary-btn:active,
.dial-btn:active,
.dock-icon-btn:active,
.power-fab:active,
.device-action:active,
.card-row:active,
.segment-item:active,
.stepper-item:active {
  transform: scale(0.98);
}

.device-list-mini {
  width: 100%;
  margin-top: 30rpx;
}

.mini-device-item {
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #f7f9fa;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.mini-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
  font-size: 26rpx;
  color: #2a363d;
}

.control-panel {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dce4e8;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 38, 0.05);
}

.dial-wrapper {
  display: flex;
  justify-content: center;
}

.temperature-dial {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  border-radius: 260rpx;
  background: #f8fafb;
  border: 1rpx solid #dce4e8;
  box-shadow: inset 0 0 0 22rpx #ffffff, inset 0 0 0 24rpx #dce4e8;
}

.temperature-dial.dial-off {
  opacity: 0.72;
}

.dial-ring {
  position: absolute;
  left: 52rpx;
  right: 52rpx;
  bottom: 62rpx;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #dce4e8;
}

.dial-progress {
  height: 100%;
  border-radius: 4rpx;
  background: #1f6feb;
}

.dial-center {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.mode-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f6feb;
  background: #eef5ff;
  font-size: 26rpx;
  font-weight: 700;
}

.temp-display {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.temp-num {
  font-size: 132rpx;
  line-height: 0.95;
  font-weight: 700;
  color: #172026;
}

.temp-unit {
  margin-top: 14rpx;
  margin-left: 6rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #51616b;
}

.mode-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6f7f89;
}

.dial-controls {
  position: absolute;
  left: 74rpx;
  right: 74rpx;
  bottom: 100rpx;
  justify-content: space-between;
}

.dial-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #172026;
  background: #ffffff;
  border: 1rpx solid #dce4e8;
  font-size: 46rpx;
  box-shadow: 0 10rpx 24rpx rgba(23, 32, 38, 0.08);
}

.temp-stepper {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.stepper-item {
  height: 66rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f7f9;
  color: #51616b;
  font-size: 25rpx;
  font-weight: 600;
}

.stepper-item.active {
  background: #172026;
  color: #ffffff;
}

.section-block,
.protocol-card,
.env-bar {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dce4e8;
}

.section-head {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: #51616b;
  font-weight: 700;
}

.segment-control {
  gap: 12rpx;
}

.segment-item {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: #f4f7f9;
  color: #51616b;
}

.segment-item.active {
  color: #ffffff;
  background: #1f6feb;
}

.segment-item.disabled {
  opacity: 0.45;
}

.seg-icon {
  font-size: 24rpx;
  font-weight: 700;
}

.seg-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1;
}

.seg-bars {
  height: 24rpx;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}

.bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  opacity: 0.35;
}

.bar:nth-child(1) {
  height: 8rpx;
}

.bar:nth-child(2) {
  height: 12rpx;
}

.bar:nth-child(3) {
  height: 17rpx;
}

.bar:nth-child(4) {
  height: 22rpx;
}

.bar.on {
  opacity: 1;
}

.card-row {
  min-height: 90rpx;
}

.card-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.card-icon,
.card-right {
  width: 62rpx;
  height: 62rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef5ff;
  color: #1f6feb;
}

.card-sub {
  margin-top: 8rpx;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #172026;
  font-size: 28rpx;
  font-weight: 600;
}

.refreshing,
.loading-icon {
  animation: spin 1s linear infinite;
}

.env-bar {
  justify-content: space-between;
}

.env-item {
  flex: 1;
  align-items: center;
}

.env-val {
  color: #172026;
  font-size: 34rpx;
  font-weight: 700;
}

.env-lbl {
  margin-top: 8rpx;
}

.env-divider {
  width: 1rpx;
  height: 52rpx;
  background: #e8edf0;
}

.bottom-dock {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(26rpx + env(safe-area-inset-bottom));
  height: 116rpx;
  z-index: 20;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dce4e8;
  box-shadow: 0 18rpx 44rpx rgba(23, 32, 38, 0.13);
}

.dock-icon-btn {
  width: 128rpx;
  height: 86rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  color: #51616b;
  font-size: 22rpx;
}

.dock-icon-btn i {
  font-size: 30rpx;
}

.power-fab {
  position: relative;
  width: 94rpx;
  height: 94rpx;
  border-radius: 47rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #172026;
  font-size: 38rpx;
  box-shadow: 0 14rpx 28rpx rgba(23, 32, 38, 0.2);
}

.power-fab.on {
  background: #1f6feb;
}

.power-fab.off {
  background: #5f6e76;
}

.power-fab.sending {
  opacity: 0.72;
}

.power-ring {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.toast-status {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 28rpx;
  z-index: 60;
  min-height: 72rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #172026;
  background: #ffffff;
  border: 1rpx solid #dce4e8;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 38, 0.14);
  font-size: 25rpx;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-18rpx);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.toast-status.show {
  opacity: 1;
  transform: translateY(0);
}

.toast-status.type-success {
  color: #0f6b3a;
}

.toast-status.type-fail {
  color: #a1271b;
}

.sheet-overlay,
.loading-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(23, 32, 38, 0.36);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.loading-overlay {
  align-items: center;
}

.loading-card {
  min-width: 220rpx;
  padding: 34rpx 42rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #2a363d;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
}

.sheet {
  width: 100%;
  max-height: 72vh;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: #ffffff;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 4rpx;
  background: #d6dee3;
}

.sheet-header {
  padding-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #172026;
}

.sheet-scroll {
  max-height: 55vh;
}

.protocol-scroll {
  max-height: 58vh;
}

.sheet-item {
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  justify-content: space-between;
  gap: 18rpx;
  color: #2a363d;
}

.sheet-item.selected {
  background: #eef5ff;
  color: #1f6feb;
}

.sheet-ico,
.sheet-check {
  color: #1f6feb;
}

.sheet-title {
  font-size: 28rpx;
  font-weight: 600;
}

.rssi-signal {
  width: 34rpx;
  height: 22rpx;
  display: flex;
  align-items: flex-end;
}

.signal-bar {
  width: 100%;
  border-radius: 4rpx;
  background: #91a0a9;
}

.signal-bar.s1 {
  height: 7rpx;
}

.signal-bar.s2 {
  height: 12rpx;
  background: #d89b20;
}

.signal-bar.s3 {
  height: 17rpx;
  background: #2d8f54;
}

.signal-bar.s4 {
  height: 22rpx;
  background: #1f6feb;
}

.hidden {
  display: none;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
